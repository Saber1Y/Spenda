# Live gasless run (/api/sponsor) — SERVER-ONLY secrets. Never prefix with NEXT_PUBLIC_.
# Copy this file to .env.local (gitignored) and paste the demo keys from internal/keys.json:
#   VERIFYING_SIGNER_KEY = keys.json .verifyingSigner.privateKey  (sponsors the paymaster signature)
#   AGENT_OWNER_KEY      = keys.json .agentOwner.privateKey       (signs the EntryPoint userOpHash)
# With these unset, the dashboard stays fully live in read-only + owner-write mode; only the
# "Run the agent" panel degrades to a disabled note.
VERIFYING_SIGNER_KEY=0x_your_verifying_signer_private_key
AGENT_OWNER_KEY=0x_your_agent_owner_private_key
